{# Overview Tab - Summary stats and daily trend chart #}

{# Summary Stats Grid #}
<div class="lr-unified-cards">
    {% include 'lindemannrock-base/_components/unified-card' with {
        value: summaryStats.total,
        description: 'Total Messages'|t('sms-manager'),
        align: 'center',
    } only %}

    {% include 'lindemannrock-base/_components/unified-card' with {
        value: summaryStats.sent,
        description: 'Sent Successfully'|t('sms-manager'),
        align: 'center',
    } only %}

    {% include 'lindemannrock-base/_components/unified-card' with {
        value: summaryStats.failed,
        description: 'Failed'|t('sms-manager'),
        align: 'center',
    } only %}

    {% include 'lindemannrock-base/_components/unified-card' with {
        value: summaryStats.successRate ~ '%',
        description: 'Success Rate'|t('sms-manager'),
        align: 'center',
    } only %}
</div>

{# Daily Trend Chart #}
<div class="lr-analytics-charts">
    <div class="lr-chart-container full-width">
        <h3>{{ 'Daily SMS Volume'|t('sms-manager') }}</h3>
        <div class="lr-chart-height-250">
            <canvas id="daily-trend-chart"></canvas>
        </div>
    </div>
</div>

{# Provider, language, and site breakdown #}
<div class="lr-analytics-charts">
    <div class="lr-chart-container">
        <h3>{{ 'By Provider'|t('sms-manager') }}</h3>
        <canvas id="provider-chart"></canvas>
    </div>
    <div class="lr-chart-container">
        <h3>{{ 'By Language'|t('sms-manager') }}</h3>
        <canvas id="language-chart"></canvas>
    </div>
    <div class="lr-chart-container">
        <h3>{{ 'By Site'|t('sms-manager') }}</h3>
        <canvas id="site-chart"></canvas>
    </div>
</div>

{# Top Providers Table #}
<div class="lr-chart-container lr-mt-24">
    <h3>{{ 'Provider Performance'|t('sms-manager') }}</h3>
    <div class="lr-table-scroll">
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>{{ 'Provider'|t('sms-manager') }}</th>
                    <th>{{ 'Site'|t('sms-manager') }}</th>
                    <th class="lr-text-end">{{ 'Sent'|t('sms-manager') }}</th>
                    <th class="lr-text-end">{{ 'Failed'|t('sms-manager') }}</th>
                    <th class="lr-text-end">{{ 'Success Rate'|t('sms-manager') }}</th>
                </tr>
            </thead>
            <tbody id="provider-table-body">
                {% if providerData|length %}
                    {% for item in providerData %}
                        {% set itemTotal = (item.sent|default(0)) + (item.failed|default(0)) %}
                        {% set itemRate = itemTotal > 0 ? ((item.sent|default(0)) / itemTotal * 100)|round(1) : 0 %}
                        <tr>
                            <td><strong>{{ item.providerName }}</strong></td>
                            <td>{{ item.siteName }}</td>
                            <td class="lr-text-end lr-text-green">{{ item.sent|number_format }}</td>
                            <td class="lr-text-end lr-text-red">{{ item.failed|number_format }}</td>
                            <td class="lr-text-end">{{ itemRate }}%</td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="5" class="light lr-text-center">{{ 'No data available'|t('sms-manager') }}</td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>
</div>
