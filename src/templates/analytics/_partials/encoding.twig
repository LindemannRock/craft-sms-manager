{# Encoding Tab - SMS encoding distribution analytics #}

{# Encoding Summary Stats #}
<div class="lr-unified-cards">
    {% include 'lindemannrock-base/_components/unified-card' with {
        value: summaryStats.gsm7,
        description: encodingLabels.gsm7 ~ ' ' ~ 'Messages'|t('sms-manager'),
        align: 'center',
    } only %}

    {% include 'lindemannrock-base/_components/unified-card' with {
        value: summaryStats.ucs2,
        description: encodingLabels.ucs2 ~ ' ' ~ 'Messages'|t('sms-manager'),
        align: 'center',
    } only %}

    {% include 'lindemannrock-base/_components/unified-card' with {
        value: summaryStats.unknownEncoding,
        description: encodingLabels.unknown ~ ' ' ~ 'Messages'|t('sms-manager'),
        align: 'center',
    } only %}

    {% include 'lindemannrock-base/_components/unified-card' with {
        value: summaryStats.characters ?? 'Unknown'|t('sms-manager'),
        description: 'Characters'|t('sms-manager'),
        align: 'center',
    } only %}

    {% include 'lindemannrock-base/_components/unified-card' with {
        value: summaryStats.segments ?? 'Unknown'|t('sms-manager'),
        description: 'SMS Segments'|t('sms-manager'),
        align: 'center',
    } only %}
</div>

{# Encoding Charts #}
<div class="lr-analytics-charts two-columns">
    <div class="lr-chart-container">
        <h3>{{ 'Distribution'|t('sms-manager') }}</h3>
        <canvas id="encoding-pie-chart"></canvas>
    </div>
    <div class="lr-chart-container">
        <h3>{{ 'Daily Breakdown'|t('sms-manager') }}</h3>
        <div class="lr-chart-height-250">
            <canvas id="encoding-daily-chart"></canvas>
        </div>
    </div>
</div>

{# Encoding Info #}
{% set encodingInfo %}
    <strong>{{ 'About SMS Encoding'|t('sms-manager') }}</strong><br><br>
    {{ 'SMS messages use different encodings based on character content, which affects segment length:'|t('sms-manager') }}<br><br>
    <strong>{{ encodingLabels.gsm7 }}</strong> — {{ '160 septets for one segment or 153 per multipart segment. Extension-table characters consume two septets.'|t('sms-manager') }}<br><br>
    <strong>{{ encodingLabels.ucs2 }}</strong> — {{ '70 UTF-16 code units for one segment or 67 per multipart segment. Emoji and other astral characters consume two units.'|t('sms-manager') }}<br><br>
    <strong>{{ encodingLabels.unknown }}</strong> — {{ 'Historical messages whose content was unavailable keep encoding, character, and segment facts unknown.'|t('sms-manager') }}
{% endset %}

{% include 'lindemannrock-base/_components/info-box' with {
    message: encodingInfo,
    type: 'info'
} %}
