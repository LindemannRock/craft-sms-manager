{#
 # Sender IDs Index - Using cp-table layout
 #
 # Follows the canonical CP table index-page pattern (in-memory variant) —
 # see plugins/base/docs/template-guides/cp-table-index-pattern.md.
 # SenderIdsController::actionIndex() owns query-param parsing, allowlist
 # validation, filter, sort, and pagination. This template stays
 # presentational and renders the already-sliced `senderIds` plus the
 # filter/sort state handed in. Permission booleans (`canCreate`, `canEdit`,
 # `canDelete`) likewise arrive from the controller.
 #}

{% extends 'lindemannrock-base/_layouts/cp-table' %}


{# ============================================================================
   BUILD PROVIDER OPTIONS FOR FILTER
   ============================================================================ #}

{% set providerOptions = [{value: 'all', label: 'All Providers'|t('sms-manager'), status: 'all'}] %}
{% for provider in providers %}
    {% set providerOptions = providerOptions|merge([{
        value: provider.handle,
        label: provider.name,
        statusColor: '#6366f1',
    }]) %}
{% endfor %}


{# ============================================================================
   TABLE CONFIGURATION
   ============================================================================ #}

{% set tableConfig = {
    plugin: {
        handle: 'sms-manager',
        name: smsHelper.fullName,
    },
    page: {
        title: 'Sender IDs'|t('sms-manager'),
        subnav: 'sender-ids',
        crumbs: [
            { label: smsHelper.fullName, url: url('sms-manager') },
            { label: 'Sender IDs'|t('sms-manager'), url: url('sms-manager/sender-ids') }
        ],
    },
    filters: [
        {
            type: 'status',
            param: 'status',
            current: statusFilter,
            label: 'All'|t('sms-manager'),
            groups: [
                {
                    param: 'status',
                    current: statusFilter,
                    colorSet: 'status',
                    options: [
                        {value: 'all', label: 'All'|t('sms-manager'), status: 'all'},
                        {value: 'enabled', label: 'Enabled'|t('sms-manager'), colorKey: 'enabled'},
                        {value: 'disabled', label: 'Disabled'|t('sms-manager'), colorKey: 'disabled'},
                    ],
                },
                {
                    header: 'Config Source'|t('sms-manager'),
                    param: 'source',
                    current: sourceFilter,
                    colorSet: 'configSource',
                    options: [
                        {value: 'all', label: 'All Sources'|t('sms-manager'), status: 'all'},
                        {value: 'config', label: 'Config File'|t('sms-manager'), colorKey: 'config'},
                        {value: 'database', label: 'Database'|t('sms-manager'), colorKey: 'database'},
                    ],
                },
                {
                    header: 'Provider'|t('sms-manager'),
                    param: 'provider',
                    current: providerFilter,
                    options: providerOptions,
                },
                {
                    header: 'Type'|t('sms-manager'),
                    param: 'test',
                    current: testFilter,
                    colorSet: 'environmentType',
                    options: [
                        {value: 'all', label: 'All Types'|t('sms-manager'), status: 'all'},
                        {value: 'production', label: 'Production'|t('sms-manager'), colorKey: 'production'},
                        {value: 'test', label: 'Development'|t('sms-manager'), colorKey: 'development'},
                    ],
                },
            ],
        },
    ],
    search: {
        placeholder: 'Search sender IDs...'|t('sms-manager'),
        value: search,
    },
    sort: {
        field: sort,
        direction: dir,
    },
    table: {
        columns: [
            {key: 'name', label: 'Name'|t('sms-manager'), sortable: true},
            {key: 'handle', label: 'Handle'|t('sms-manager'), sortable: true, hideable: true},
            {key: 'senderId', label: 'Sender ID'|t('sms-manager'), sortable: true, hideable: true},
            {key: 'provider', label: 'Provider'|t('sms-manager'), sortable: true, hideable: true},
            {key: 'isDev', label: 'Type'|t('sms-manager'), sortable: true, hideable: true},
            {key: 'source', label: 'Source'|t('sms-manager'), sortable: true, hideable: true},
            {key: 'enabled', label: 'Status'|t('sms-manager'), sortable: true, hideable: true},
            {key: 'default', label: 'Default'|t('sms-manager'), hideable: true},
        ],
        items: senderIds,
        emptyMessage: 'No sender IDs found.'|t('sms-manager'),
        hasConfigItems: true,
    },
    pagination: {
        page: page,
        limit: limit,
        totalCount: totalCount,
        itemLabel: {singular: 'sender ID'|t('sms-manager'), plural: 'sender IDs'|t('sms-manager')},
    },
    checkboxes: canEdit or canDelete,
    newButton: canCreate ? {
        url: url('sms-manager/sender-ids/new'),
        label: 'New Sender ID'|t('sms-manager'),
    } : null,
} %}


{# ============================================================================
   BEFORE TABLE - Warning messages
   ============================================================================ #}

{% block beforeTable %}
    {# Warning if default sender ID is missing or disabled. The controller
       resolves `defaultSenderId` against the full sender ID list (not the
       filtered/paginated `senderIds`), so these warnings stay consistent
       regardless of the current filter. #}
    {% if defaultSenderIdHandle %}
        {% if not defaultSenderId %}
            {% set warningMessage %}
            <strong>{{ 'Warning'|t('sms-manager') }}:</strong>
            {{ 'The default sender ID handle "{handle}" does not exist.'|t('sms-manager', {handle: '<strong>' ~ defaultSenderIdHandle|e ~ '</strong>'})|raw }}
            {% if isDefaultFromConfig %}
                {{ 'Update your config/sms-manager.php to point to a valid sender ID handle.'|t('sms-manager') }}
            {% else %}
                {{ 'Please set a different sender ID as default.'|t('sms-manager') }}
            {% endif %}
            {% endset %}
            <div class="lr-info-box-table-wrapper">
                {% include 'lindemannrock-base/_components/info-box' with {
                    message: warningMessage,
                    type: 'warning',
                    margin: 'none',
                    stretch: true,
                } %}
            </div>
        {% elseif not defaultSenderId.enabled %}
            {% set warningMessage %}
            <strong>{{ 'Warning'|t('sms-manager') }}:</strong>
            {{ 'The default sender ID "{name}" is disabled. SMS functionality may not work.'|t('sms-manager', {name: '<strong>' ~ defaultSenderId.name|e ~ '</strong>'})|raw }}
            {% if not isDefaultFromConfig %}
                {{ 'Please enable it or set a different sender ID as default.'|t('sms-manager') }}
            {% else %}
                {{ 'Update your config/sms-manager.php to fix this.'|t('sms-manager') }}
            {% endif %}
            {% endset %}
            <div class="lr-info-box-table-wrapper">
                {% include 'lindemannrock-base/_components/info-box' with {
                    message: warningMessage,
                    type: 'warning',
                    margin: 'none',
                    stretch: true,
                } %}
            </div>
        {% endif %}
    {% elseif hasAnySenderIds %}
        {% set warningMessage %}
        <strong>{{ 'Warning'|t('sms-manager') }}:</strong>
        {{ 'No default sender ID is configured. Please set one of the sender IDs as default.'|t('sms-manager') }}
        {% endset %}
        <div class="lr-info-box-table-wrapper">
            {% include 'lindemannrock-base/_components/info-box' with {
                message: warningMessage,
                type: 'warning',
                margin: 'none',
                stretch: true,
            } %}
        </div>
    {% endif %}

    {# Warning for handle collisions between config and database #}
    {% if collisionHandles is defined and collisionHandles|length %}
        {% set boldHandles = [] %}
        {% for handle in collisionHandles %}
            {% set boldHandles = boldHandles|merge(['<strong>' ~ handle|e ~ '</strong>']) %}
        {% endfor %}
        {% set warningMessage %}
        <strong>{{ 'Warning'|t('sms-manager') }}:</strong>
        {{ 'These sender ID handles exist in both config/sms-manager.php and the database:'|t('sms-manager') }} {{ boldHandles|join(', ')|raw }}.
        {{ 'Config takes precedence; database entries with the same handle are ignored.'|t('sms-manager') }}
        {{ 'Update your config/sms-manager.php or remove the database entries to resolve this.'|t('sms-manager') }}
        {% endset %}
        <div class="lr-info-box-table-wrapper">
            {% include 'lindemannrock-base/_components/info-box' with {
                message: warningMessage,
                type: 'warning',
                margin: 'none',
                stretch: true,
            } %}
        </div>
    {% endif %}
{% endblock %}


{# ============================================================================
   BULK ACTIONS (shown when items selected)
   ============================================================================ #}

{% block bulkActions %}
    {% if canEdit %}
        {% include 'lindemannrock-base/_components/bulk-status-menu' with {
            label: 'Set status'|t('sms-manager'),
            countId: 'lr-bulk-status-count',
            items: [
                {id: 'lr-bulk-enable-action', label: 'Enable'|t('sms-manager'), status: 'enabled'},
                {id: 'lr-bulk-disable-action', label: 'Disable'|t('sms-manager'), status: 'disabled'},
            ],
        } only %}
    {% endif %}
    {% if canDelete %}
        {% include 'lindemannrock-base/_components/bulk-actions-menu' with {
            label: 'Actions'|t('sms-manager'),
            countId: 'lr-bulk-actions-count',
            items: [
                {id: 'lr-bulk-delete-btn', label: 'Delete'|t('sms-manager'), class: 'error'},
            ],
        } only %}
    {% endif %}
{% endblock %}


{# ============================================================================
   ROW ACTIONS (per-row menu)
   ============================================================================ #}

{% block rowActions %}
    {% set isDefault = defaultSenderIdHandle == item.handle %}
    {% set itemId = item.id ?: item.handle %}

    {% set actionItems = [] %}

    {% if item.canEdit() %}
        {% set actionItems = actionItems|merge([{
            label: 'Edit'|t('sms-manager'),
            url: url('sms-manager/sender-ids/' ~ item.id),
            permission: 'smsManager:editSenderIds',
        }]) %}
    {% else %}
        {% set actionItems = actionItems|merge([{
            label: 'View'|t('sms-manager'),
            url: url('sms-manager/sender-ids/view/' ~ item.handle),
        }]) %}
    {% endif %}

    {% set actionItems = actionItems|merge([
        {type: 'divider'},
        {
            label: 'Set as Default'|t('sms-manager'),
            jsAction: 'set-default',
            data: {name: item.name},
            hideIf: isDefaultFromConfig or isDefault,
            permission: 'smsManager:editSenderIds',
        },
    ]) %}

    {% set actionItems = actionItems|merge([
        {type: 'divider'},
        {
            label: 'Delete'|t('sms-manager'),
            class: 'error',
            jsAction: 'delete',
            data: {name: item.name},
            hideIf: isDefault,
            showIf: item.canEdit(),
            permission: 'smsManager:deleteSenderIds',
        },
    ]) %}

    {% include 'lindemannrock-base/_components/row-actions' with {
        item: {id: itemId},
        actions: {
            type: 'menu',
            icon: 'settings',
            title: 'Actions'|t('sms-manager'),
            items: actionItems,
        },
    } only %}
{% endblock %}


{# ============================================================================
   CUSTOM TABLE ROW RENDERING
   ============================================================================ #}

{% block tableRow %}
    {# Provider for this sender ID — O(1) lookup against the controller-built
       providersByHandle map (replaces a per-row `{% for p in providers %}`). #}
    {% set provider = providersByHandle[item.providerHandle] ?? null %}

    {# Name #}
    <td>
        {% if item.canEdit() %}
            <a class="label-link" href="{{ url('sms-manager/sender-ids/' ~ item.id) }}">
                <span>{{ item.name }}</span>
            </a>
        {% else %}
            <a class="label-link" href="{{ url('sms-manager/sender-ids/view/' ~ item.handle) }}">
                <span>{{ item.name }}</span>
            </a>
            <span class="lr-config-info-icon" data-config="{{ item.rawConfigDisplay|e('html_attr') }}" data-config-source="config/sms-manager.php"></span>
        {% endif %}
    </td>

    {# Handle #}
    <td><code>{{ item.handle }}</code></td>

    {# Sender ID value #}
    <td><code>{{ item.senderId }}</code></td>

    {# Provider badge #}
    <td>
        {% if provider %}
            {% set providerUrl = provider.canEdit() ? url('sms-manager/providers/' ~ provider.id) : url('sms-manager/providers/view/' ~ provider.handle) %}
            <a href="{{ providerUrl }}" style="text-decoration: none;">
                {% include 'lindemannrock-base/_components/badge' with {
                    label: provider.type|upper,
                    value: provider.type,
                    colorSet: 'smsProviderType',
                } only %}
            </a>
        {% else %}
            <span class="light">{{ 'Unknown'|t('sms-manager') }}</span>
        {% endif %}
    </td>

    {# Type badge (Dev/Production) #}
    <td>
        {% include 'lindemannrock-base/_components/badge' with {
            label: item.isDev ? 'Development'|t('sms-manager') : 'Production'|t('sms-manager'),
            value: item.isDev ? 'development' : 'production',
            colorSet: 'environmentType',
        } only %}
    </td>

    {# Source badge #}
    <td>
        {% include 'lindemannrock-base/_components/badge' with {
            label: item.source == 'config' ? 'Config'|t('sms-manager') : 'Database'|t('sms-manager'),
            value: item.source,
            colorSet: 'configSource',
        } only %}
    </td>

    {# Status badge #}
    <td>
        {% include 'lindemannrock-base/_components/badge' with {
            label: item.enabled ? 'Enabled'|t('sms-manager') : 'Disabled'|t('sms-manager'),
            value: item.enabled ? 'enabled' : 'disabled',
            colorSet: 'status',
        } only %}
    </td>

    {# Default indicator #}
    <td>
        {% if defaultSenderIdHandle == item.handle %}
            {% include 'lindemannrock-base/_components/badge' with {
                label: 'Yes'|t('sms-manager'),
                value: 'yes',
                colorSet: 'yesNo',
            } only %}
        {% else %}
            <span class="light">-</span>
        {% endif %}
    </td>
{% endblock %}


{# ============================================================================
   CUSTOM SCRIPTS
   ============================================================================ #}

{% block scripts %}
    <script>
    (function() {
        if (typeof Craft === 'undefined') return;

        // Pre-translated strings: keep |t() in Twig (so they're translatable)
        // and emit as JSON-encoded JS literals via |json_encode|raw — avoids
        // the |e('js') trap (produces \uXXXX garbage when re-quoted).
        const T = {
            defaultUpdated: {{ 'Default sender ID updated.'|t('sms-manager')|json_encode|raw }},
            defaultUpdateFailed: {{ 'Failed to update default sender ID.'|t('sms-manager')|json_encode|raw }},
            senderIdDeleted: {{ 'Sender ID deleted.'|t('sms-manager')|json_encode|raw }},
            deleteFailed: {{ 'Could not delete sender ID.'|t('sms-manager')|json_encode|raw }},
            deleteConfirmTemplate: {{ 'Delete sender ID "{name}"? This cannot be undone.'|t('sms-manager')|json_encode|raw }},
            bulkEnabledTemplate: {{ 'Enabled {count} sender IDs'|t('sms-manager')|json_encode|raw }},
            bulkEnableFailed: {{ 'Failed to enable sender IDs'|t('sms-manager')|json_encode|raw }},
            bulkDisabledTemplate: {{ 'Disabled {count} sender IDs'|t('sms-manager')|json_encode|raw }},
            bulkDisableFailed: {{ 'Failed to disable sender IDs'|t('sms-manager')|json_encode|raw }},
            bulkDeletedTemplate: {{ 'Deleted {count} sender IDs'|t('sms-manager')|json_encode|raw }},
            bulkDeleteFailed: {{ 'Failed to delete sender IDs'|t('sms-manager')|json_encode|raw }},
            bulkDeleteConfirmSingular: {{ 'Delete {count} sender ID? This cannot be undone.'|t('sms-manager')|json_encode|raw }},
            bulkDeleteConfirmPlural: {{ 'Delete {count} sender IDs? This cannot be undone.'|t('sms-manager')|json_encode|raw }},
        };

        // Highlight rows with handle collisions between config and database.
        const collisionHandles = {{ collisionHandles|default([])|json_encode|raw }};
        if (collisionHandles.length > 0) {
            document.querySelectorAll('#lr-data-table tbody tr.lr-data-row').forEach(function(row) {
                const handleCell = row.querySelector('td:nth-child(3) code');
                if (handleCell && collisionHandles.includes(handleCell.textContent.trim())) {
                    row.classList.add('lr-row--warning');
                }
            });
        }

        function selectedIds() {
            return window.lrTableSelection ? window.lrTableSelection.getSelectedIds() : [];
        }

        // ---------------------------------------------------------------------
        // Row-action handlers. Delegated listener on `document`, narrowed by
        // `a[data-action]` + an explicit action-name allowlist. preventDefault
        // only after the match — leaves unrelated `data-action` elements
        // (e.g. Craft toolbar forms) alone. See cp-table-index-pattern.md.
        // Confirmation lives here (single source of truth); do not also set
        // `confirm:` on the action item.
        // ---------------------------------------------------------------------
        document.addEventListener('click', function(e) {
            const trigger = e.target.closest('a[data-action]');
            if (!trigger) return;

            const action = trigger.dataset.action;
            if (action !== 'set-default' && action !== 'delete') return;

            const senderIdId = trigger.dataset.id;
            const senderIdName = trigger.dataset.name || '';
            if (!senderIdId) return;
            e.preventDefault();

            if (action === 'set-default') {
                Craft.sendActionRequest('POST', 'sms-manager/sender-ids/set-default', {
                    data: { senderIdId: senderIdId },
                }).then(function(response) {
                    if (response.data.success) {
                        Craft.cp.displayNotice(T.defaultUpdated);
                        setTimeout(function() { window.location.reload(); }, 500);
                    } else {
                        Craft.cp.displayError(response.data.error || T.defaultUpdateFailed);
                    }
                }).catch(function() {
                    Craft.cp.displayError(T.defaultUpdateFailed);
                });
            } else if (action === 'delete') {
                const confirmMessage = T.deleteConfirmTemplate.replace('{name}', senderIdName);
                if (!confirm(confirmMessage)) return;
                Craft.sendActionRequest('POST', 'sms-manager/sender-ids/delete', {
                    data: { senderIdId: senderIdId },
                }).then(function(response) {
                    if (response.data.success) {
                        Craft.cp.displayNotice(T.senderIdDeleted);
                        setTimeout(function() { window.location.reload(); }, 1000);
                    } else if (response.data.error) {
                        Craft.cp.displayError(response.data.error);
                    }
                }).catch(function() {
                    Craft.cp.displayError(T.deleteFailed);
                });
            }
        });

        // ---------------------------------------------------------------------
        // Bulk actions. Each posts the selected IDs to its endpoint; the
        // controller surfaces per-row errors via `response.data.errors`.
        // ---------------------------------------------------------------------
        function runBulkStatus(endpoint, successTemplate, errorFallback) {
            const ids = selectedIds();
            if (!ids.length) return;
            Craft.sendActionRequest('POST', endpoint, {
                data: { senderIdIds: ids },
            }).then(function(response) {
                const count = response.data.count || 0;
                if (count > 0) {
                    Craft.cp.displayNotice(successTemplate.replace('{count}', count));
                }
                if (Array.isArray(response.data.errors)) {
                    response.data.errors.forEach(function(err) { Craft.cp.displayError(err); });
                } else if (response.data.error) {
                    Craft.cp.displayError(response.data.error);
                }
                if (count > 0) {
                    setTimeout(function() { window.location.reload(); }, 1000);
                }
            }).catch(function() {
                Craft.cp.displayError(errorFallback);
            });
        }

        document.getElementById('lr-bulk-enable-action')?.addEventListener('click', function(e) {
            e.preventDefault();
            runBulkStatus('sms-manager/sender-ids/bulk-enable', T.bulkEnabledTemplate, T.bulkEnableFailed);
        });

        document.getElementById('lr-bulk-disable-action')?.addEventListener('click', function(e) {
            e.preventDefault();
            runBulkStatus('sms-manager/sender-ids/bulk-disable', T.bulkDisabledTemplate, T.bulkDisableFailed);
        });

        document.getElementById('lr-bulk-delete-btn')?.addEventListener('click', function() {
            const ids = selectedIds();
            if (!ids.length) return;
            const confirmTemplate = ids.length === 1 ? T.bulkDeleteConfirmSingular : T.bulkDeleteConfirmPlural;
            if (!confirm(confirmTemplate.replace('{count}', ids.length))) return;
            runBulkStatus('sms-manager/sender-ids/bulk-delete', T.bulkDeletedTemplate, T.bulkDeleteFailed);
        });
    })();
    </script>
{% endblock %}
