{#
 # Providers Index - Using cp-table layout
 #
 # Follows the canonical CP table index-page pattern (in-memory variant) —
 # see plugins/base/docs/template-guides/cp-table-index-pattern.md.
 # ProvidersController::actionIndex() owns query-param parsing, allowlist
 # validation, filter, sort, and pagination. This template stays
 # presentational and renders the already-sliced `providers` plus the
 # filter/sort state handed in. Permission booleans (`canCreate`, `canEdit`,
 # `canDelete`) likewise arrive from the controller.
 #}

{% extends 'lindemannrock-base/_layouts/cp-table' %}


{# ============================================================================
   TABLE CONFIGURATION
   ============================================================================ #}

{% set tableConfig = {
    plugin: {
        handle: 'sms-manager',
        name: smsHelper.fullName,
    },
    page: {
        title: 'Providers'|t('sms-manager'),
        subnav: 'providers',
        crumbs: [
            { label: smsHelper.fullName, url: url('sms-manager') },
            { label: 'Providers'|t('sms-manager'), url: url('sms-manager/providers') }
        ],
    },
    filters: [
        {
            type: 'status',
            param: 'status',
            current: statusFilter,
            label: 'All'|t('sms-manager'),
            groups: [
                {
                    param: 'status',
                    current: statusFilter,
                    colorSet: 'status',
                    options: [
                        {value: 'all', label: 'All'|t('sms-manager'), status: 'all'},
                        {value: 'enabled', label: 'Enabled'|t('sms-manager'), colorKey: 'enabled'},
                        {value: 'disabled', label: 'Disabled'|t('sms-manager'), colorKey: 'disabled'},
                    ],
                },
                {
                    header: 'Config Source'|t('sms-manager'),
                    param: 'source',
                    current: sourceFilter,
                    colorSet: 'configSource',
                    options: [
                        {value: 'all', label: 'All Sources'|t('sms-manager'), status: 'all'},
                        {value: 'config', label: 'Config File'|t('sms-manager'), colorKey: 'config'},
                        {value: 'database', label: 'Database'|t('sms-manager'), colorKey: 'database'},
                    ],
                },
            ],
        },
    ],
    search: {
        placeholder: 'Search providers...'|t('sms-manager'),
        value: search,
    },
    sort: {
        field: sort,
        direction: dir,
    },
    table: {
        columns: [
            {key: 'name', label: 'Name'|t('sms-manager'), sortable: true},
            {key: 'handle', label: 'Handle'|t('sms-manager'), sortable: true, hideable: true},
            {key: 'type', label: 'Type'|t('sms-manager'), sortable: true, hideable: true},
            {key: 'source', label: 'Source'|t('sms-manager'), sortable: true, hideable: true},
            {key: 'enabled', label: 'Status'|t('sms-manager'), sortable: true, hideable: true},
            {key: 'default', label: 'Default'|t('sms-manager'), hideable: true},
        ],
        items: providers,
        emptyMessage: 'No providers found.'|t('sms-manager'),
        hasConfigItems: true,
    },
    pagination: {
        page: page,
        limit: limit,
        totalCount: totalCount,
        itemLabel: {singular: 'provider'|t('sms-manager'), plural: 'providers'|t('sms-manager')},
    },
    checkboxes: canEdit or canDelete,
    newButton: canCreate ? {
        url: url('sms-manager/providers/new'),
        label: 'New Provider'|t('sms-manager'),
    } : null,
} %}


{# ============================================================================
   BEFORE TABLE - Warning messages
   ============================================================================ #}

{% block beforeTable %}
    {# Warning if default provider is missing or disabled. The controller
       resolves `defaultProvider` against the full provider list (not the
       filtered/paginated `providers`), so these warnings stay consistent
       regardless of the current filter. #}
    {% if defaultProviderHandle %}
        {% if not defaultProvider %}
            {# Default provider doesn't exist #}
            {% set warningMessage %}
            <strong>{{ 'Warning'|t('sms-manager') }}:</strong>
            {{ 'The default provider handle "{handle}" does not exist.'|t('sms-manager', {handle: '<strong>' ~ defaultProviderHandle|e ~ '</strong>'})|raw }}
            {% if isDefaultFromConfig %}
                {{ 'Update your config/sms-manager.php to point to a valid provider handle.'|t('sms-manager') }}
            {% else %}
                {{ 'Please set a different provider as default.'|t('sms-manager') }}
            {% endif %}
            {% endset %}
            <div class="lr-info-box-table-wrapper">
                {% include 'lindemannrock-base/_components/info-box' with {
                    message: warningMessage,
                    type: 'warning',
                    margin: 'none',
                    stretch: true,
                } %}
            </div>
        {% elseif not defaultProvider.enabled %}
            {# Default provider exists but is disabled #}
            {% set warningMessage %}
            <strong>{{ 'Warning'|t('sms-manager') }}:</strong>
            {{ 'The default provider "{name}" is disabled. SMS functionality may not work.'|t('sms-manager', {name: '<strong>' ~ defaultProvider.name|e ~ '</strong>'})|raw }}
            {% if not isDefaultFromConfig %}
                {{ 'Please enable it or set a different provider as default.'|t('sms-manager') }}
            {% else %}
                {{ 'Update your config/sms-manager.php to fix this.'|t('sms-manager') }}
            {% endif %}
            {% endset %}
            <div class="lr-info-box-table-wrapper">
                {% include 'lindemannrock-base/_components/info-box' with {
                    message: warningMessage,
                    type: 'warning',
                    margin: 'none',
                    stretch: true,
                } %}
            </div>
        {% endif %}
    {% elseif hasAnyProviders %}
        {# No default handle set but providers exist #}
        {% set warningMessage %}
        <strong>{{ 'Warning'|t('sms-manager') }}:</strong>
        {{ 'No default provider is configured. Please set one of the providers as default.'|t('sms-manager') }}
        {% endset %}
        <div class="lr-info-box-table-wrapper">
            {% include 'lindemannrock-base/_components/info-box' with {
                message: warningMessage,
                type: 'warning',
                margin: 'none',
                stretch: true,
            } %}
        </div>
    {% endif %}

    {# Warning for handle collisions between config and database #}
    {% if collisionHandles is defined and collisionHandles|length %}
        {% set boldHandles = [] %}
        {% for handle in collisionHandles %}
            {% set boldHandles = boldHandles|merge(['<strong>' ~ handle|e ~ '</strong>']) %}
        {% endfor %}
        {% set warningMessage %}
        <strong>{{ 'Warning'|t('sms-manager') }}:</strong>
        {{ 'These provider handles exist in both config/sms-manager.php and the database:'|t('sms-manager') }} {{ boldHandles|join(', ')|raw }}.
        {{ 'Config takes precedence; database entries with the same handle are ignored.'|t('sms-manager') }}
        {{ 'Update your config/sms-manager.php or remove the database entries to resolve this.'|t('sms-manager') }}
        {% endset %}
        <div class="lr-info-box-table-wrapper">
            {% include 'lindemannrock-base/_components/info-box' with {
                message: warningMessage,
                type: 'warning',
                margin: 'none',
                stretch: true,
            } %}
        </div>
    {% endif %}
{% endblock %}


{# ============================================================================
   BULK ACTIONS (shown when items selected)
   ============================================================================ #}

{% block bulkActions %}
    {% if canEdit %}
        <div class="btngroup">
            <button type="button" class="btn menubtn secondary" id="lr-bulk-status-btn">
                {{ 'Set status'|t('app') }}
            </button>
            <div class="menu">
                <ul>
                    <li><a id="lr-bulk-enable-action">{{ 'Enable'|t('sms-manager') }}</a></li>
                    <li><a id="lr-bulk-disable-action">{{ 'Disable'|t('sms-manager') }}</a></li>
                </ul>
            </div>
        </div>
    {% endif %}
    {% if canDelete %}
        <button type="button" class="btn secondary" id="lr-bulk-delete-btn">
            {{ 'Delete'|t('app') }} (<span id="lr-selected-count">0</span>)
        </button>
    {% endif %}
{% endblock %}


{# ============================================================================
   ROW ACTIONS (per-row menu)
   ============================================================================ #}

{% block rowActions %}
    {% set isDefault = defaultProviderHandle == item.handle %}
    {% set itemId = item.id ?: item.handle %}

    {% set actionItems = [] %}

    {% if item.canEdit() %}
        {% set actionItems = actionItems|merge([{
            label: 'Edit'|t('app'),
            url: url('sms-manager/providers/' ~ item.id),
            permission: 'smsManager:editProviders',
        }]) %}
    {% else %}
        {% set actionItems = actionItems|merge([{
            label: 'View'|t('app'),
            url: url('sms-manager/providers/view/' ~ item.handle),
        }]) %}
    {% endif %}

    {% set actionItems = actionItems|merge([
        {type: 'divider'},
        {
            label: 'Set as Default'|t('sms-manager'),
            jsAction: 'set-default',
            data: {name: item.name},
            hideIf: isDefaultFromConfig or isDefault,
            permission: 'smsManager:editProviders',
        },
    ]) %}

    {% set actionItems = actionItems|merge([
        {type: 'divider'},
        {
            label: 'Delete'|t('app'),
            class: 'error',
            jsAction: 'delete',
            data: {name: item.name},
            hideIf: isDefault,
            showIf: item.canEdit(),
            permission: 'smsManager:deleteProviders',
        },
    ]) %}

    {% include 'lindemannrock-base/_components/row-actions' with {
        item: {id: itemId},
        actions: {
            type: 'menu',
            icon: 'settings',
            title: 'Actions'|t('app'),
            items: actionItems,
        },
    } only %}
{% endblock %}


{# ============================================================================
   CUSTOM TABLE ROW RENDERING
   ============================================================================ #}

{% block tableRow %}
    {# Name #}
    <td>
        {% if item.canEdit() %}
            <a class="label-link" href="{{ url('sms-manager/providers/' ~ item.id) }}">
                <span>{{ item.name }}</span>
            </a>
        {% else %}
            <a class="label-link" href="{{ url('sms-manager/providers/view/' ~ item.handle) }}">
                <span>{{ item.name }}</span>
            </a>
            <span class="lr-config-info-icon" data-config="{{ item.rawConfigDisplay|e('html_attr') }}" data-config-source="config/sms-manager.php"></span>
        {% endif %}
    </td>

    {# Handle #}
    <td><code>{{ item.handle }}</code></td>

    {# Type badge #}
    <td>
        {% include 'lindemannrock-base/_components/badge' with {
            label: item.type|upper,
            value: item.type,
            colorSet: 'smsProviderType',
        } only %}
    </td>

    {# Source badge #}
    <td>
        {% include 'lindemannrock-base/_components/badge' with {
            label: item.source|capitalize,
            value: item.source,
            colorSet: 'configSource',
        } only %}
    </td>

    {# Status badge #}
    <td>
        {% include 'lindemannrock-base/_components/badge' with {
            label: item.enabled ? 'Enabled'|t('sms-manager') : 'Disabled'|t('sms-manager'),
            value: item.enabled ? 'enabled' : 'disabled',
            colorSet: 'status',
        } only %}
    </td>

    {# Default indicator #}
    <td>
        {% if defaultProviderHandle == item.handle %}
            {% include 'lindemannrock-base/_components/badge' with {
                label: 'Yes'|t('sms-manager'),
                value: 'yes',
                colorSet: 'yesNo',
            } only %}
        {% else %}
            <span class="light">-</span>
        {% endif %}
    </td>
{% endblock %}


{# ============================================================================
   CUSTOM SCRIPTS
   ============================================================================ #}

{% block scripts %}
    <script>
    (function() {
        if (typeof Craft === 'undefined') return;

        // Initialise the "Set status" menubtn — without `new Craft.MenuBtn(...)`,
        // clicking the button doesn't open its menu so the Enable/Disable items
        // inside are unreachable.
        const bulkStatusBtn = document.getElementById('lr-bulk-status-btn');
        if (bulkStatusBtn && Craft.MenuBtn) {
            new Craft.MenuBtn(bulkStatusBtn);
        }

        // Pre-translated strings: keep |t() in Twig (so they're translatable)
        // and emit as JSON-encoded JS literals via |json_encode|raw — avoids
        // the |e('js') trap (produces \uXXXX garbage when re-quoted).
        const T = {
            defaultUpdated: {{ 'Default provider updated.'|t('sms-manager')|json_encode|raw }},
            defaultUpdateFailed: {{ 'Failed to update default provider.'|t('sms-manager')|json_encode|raw }},
            providerDeleted: {{ 'Provider deleted.'|t('sms-manager')|json_encode|raw }},
            deleteFailed: {{ 'Could not delete provider.'|t('sms-manager')|json_encode|raw }},
            deleteConfirmTemplate: {{ 'Delete provider "{name}"? This cannot be undone.'|t('sms-manager')|json_encode|raw }},
            bulkEnabledTemplate: {{ 'Enabled {count} providers'|t('sms-manager')|json_encode|raw }},
            bulkEnableFailed: {{ 'Failed to enable providers'|t('sms-manager')|json_encode|raw }},
            bulkDisabledTemplate: {{ 'Disabled {count} providers'|t('sms-manager')|json_encode|raw }},
            bulkDisableFailed: {{ 'Failed to disable providers'|t('sms-manager')|json_encode|raw }},
            bulkDeletedTemplate: {{ 'Deleted {count} providers'|t('sms-manager')|json_encode|raw }},
            bulkDeleteFailed: {{ 'Failed to delete providers'|t('sms-manager')|json_encode|raw }},
            bulkDeleteConfirmTemplate: {{ 'Delete {count} provider(s)? This cannot be undone.'|t('sms-manager')|json_encode|raw }},
        };

        // Highlight rows with handle collisions between config and database.
        const collisionHandles = {{ collisionHandles|default([])|json_encode|raw }};
        if (collisionHandles.length > 0) {
            document.querySelectorAll('#lr-data-table tbody tr.lr-data-row').forEach(function(row) {
                const handleCell = row.querySelector('td:nth-child(3) code');
                if (handleCell && collisionHandles.includes(handleCell.textContent.trim())) {
                    row.classList.add('lr-row--warning');
                }
            });
        }

        document.addEventListener('lr:selectionChanged', function(e) {
            const countSpan = document.getElementById('lr-selected-count');
            if (countSpan) {
                countSpan.textContent = e.detail && typeof e.detail.count === 'number' ? e.detail.count : 0;
            }
        });

        function selectedIds() {
            return window.lrTableSelection ? window.lrTableSelection.getSelectedIds() : [];
        }

        // ---------------------------------------------------------------------
        // Row-action handlers. Delegated listener on `document`, narrowed by
        // `a[data-action]` + an explicit action-name allowlist. preventDefault
        // only after the match — leaves unrelated `data-action` elements
        // (e.g. Craft toolbar forms) alone. See cp-table-index-pattern.md.
        // Confirmation lives here (single source of truth); do not also set
        // `confirm:` on the action item.
        // ---------------------------------------------------------------------
        document.addEventListener('click', function(e) {
            const trigger = e.target.closest('a[data-action]');
            if (!trigger) return;

            const action = trigger.dataset.action;
            if (action !== 'set-default' && action !== 'delete') return;

            const providerId = trigger.dataset.id;
            const providerName = trigger.dataset.name || '';
            if (!providerId) return;
            e.preventDefault();

            if (action === 'set-default') {
                Craft.sendActionRequest('POST', 'sms-manager/providers/set-default', {
                    data: { providerId: providerId },
                }).then(function(response) {
                    if (response.data.success) {
                        Craft.cp.displayNotice(T.defaultUpdated);
                        setTimeout(function() { window.location.reload(); }, 500);
                    } else {
                        Craft.cp.displayError(response.data.error || T.defaultUpdateFailed);
                    }
                }).catch(function() {
                    Craft.cp.displayError(T.defaultUpdateFailed);
                });
            } else if (action === 'delete') {
                const confirmMessage = T.deleteConfirmTemplate.replace('{name}', providerName);
                if (!confirm(confirmMessage)) return;
                Craft.sendActionRequest('POST', 'sms-manager/providers/delete', {
                    data: { providerId: providerId },
                }).then(function(response) {
                    if (response.data.success) {
                        Craft.cp.displayNotice(T.providerDeleted);
                        setTimeout(function() { window.location.reload(); }, 1000);
                    } else if (response.data.error) {
                        Craft.cp.displayError(response.data.error);
                    }
                }).catch(function() {
                    Craft.cp.displayError(T.deleteFailed);
                });
            }
        });

        // ---------------------------------------------------------------------
        // Bulk actions. Each posts the selected IDs to its endpoint; the
        // controller surfaces per-row errors via `response.data.errors`.
        // ---------------------------------------------------------------------
        function runBulkStatus(endpoint, successTemplate, errorFallback) {
            const ids = selectedIds();
            if (!ids.length) return;
            Craft.sendActionRequest('POST', endpoint, {
                data: { providerIds: ids },
            }).then(function(response) {
                const count = response.data.count || 0;
                if (count > 0) {
                    Craft.cp.displayNotice(successTemplate.replace('{count}', count));
                }
                if (Array.isArray(response.data.errors)) {
                    response.data.errors.forEach(function(err) { Craft.cp.displayError(err); });
                } else if (response.data.error) {
                    Craft.cp.displayError(response.data.error);
                }
                if (count > 0) {
                    setTimeout(function() { window.location.reload(); }, 1000);
                }
            }).catch(function() {
                Craft.cp.displayError(errorFallback);
            });
        }

        document.getElementById('lr-bulk-enable-action')?.addEventListener('click', function(e) {
            e.preventDefault();
            runBulkStatus('sms-manager/providers/bulk-enable', T.bulkEnabledTemplate, T.bulkEnableFailed);
        });

        document.getElementById('lr-bulk-disable-action')?.addEventListener('click', function(e) {
            e.preventDefault();
            runBulkStatus('sms-manager/providers/bulk-disable', T.bulkDisabledTemplate, T.bulkDisableFailed);
        });

        document.getElementById('lr-bulk-delete-btn')?.addEventListener('click', function() {
            const ids = selectedIds();
            if (!ids.length) return;
            if (!confirm(T.bulkDeleteConfirmTemplate.replace('{count}', ids.length))) return;
            runBulkStatus('sms-manager/providers/bulk-delete', T.bulkDeletedTemplate, T.bulkDeleteFailed);
        });
    })();
    </script>
{% endblock %}
