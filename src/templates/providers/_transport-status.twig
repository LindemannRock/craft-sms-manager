{% import 'sms-manager/_components/_transport-labels' as transportLabels %}
<fieldset id="sms-transport-status">
    <legend class="h6">{{ 'Transport Status'|t('sms-manager') }}</legend>
    {% if not transportStatus.available or transportStatus.holds is empty %}
        <div class="meta">
            <div class="field">
                <div class="heading"><label>{{ 'Transport'|t('sms-manager') }}</label></div>
                <div class="input">
                    {% include 'lindemannrock-base/_components/status-dot' with {value: transportStatus.state, colorSet: 'smsTransportStatus'} only %}
                    <span>{{ transportLabels.status(transportStatus.state) }}</span>
                </div>
            </div>
            {% if transportStatus.state == 'not-configured' %}
                <p class="light">{{ 'This provider has not configured shared transport protection.'|t('sms-manager') }}</p>
            {% endif %}
        </div>
    {% else %}
        {% set typeLabels = {
            'account-unavailable': 'Account unavailable'|t('sms-manager'),
            'ip-blocked': 'IP blocked'|t('sms-manager'),
            'admission-uncertain': 'Safety hold'|t('sms-manager'),
            'manual-hold': 'Manual hold'|t('sms-manager'),
            'rate-limited': 'Rate limited'|t('sms-manager'),
            'provider-unavailable': 'Provider unavailable'|t('sms-manager'),
        } %}
        {% for hold in transportStatus.holds %}
            <div class="meta">
                <div class="field">
                    <div class="heading"><label>{{ 'Transport'|t('sms-manager') }}</label></div>
                    <div class="input">
                        {% set state = hold.active ? 'on-hold' : 'expired' %}
                        {% include 'lindemannrock-base/_components/status-dot' with {value: state, colorSet: 'smsTransportStatus'} only %}
                        <span>{{ transportLabels.status(state) }}</span>
                    </div>
                </div>
                {% set fields = [
                    {label: 'Hold type'|t('sms-manager'), value: typeLabels[hold.type]},
                    {label: 'Account'|t('sms-manager'), value: transportLabels.lane(hold.lane)},
                    {label: 'Activated at'|t('sms-manager'), value: hold.activatedAt|lrDatetime},
                    {label: 'Automatic recovery'|t('sms-manager'), value: hold.recoveryAt ? hold.recoveryAt|lrDatetime : 'Manual release required'|t('sms-manager')},
                ] %}
                {% for field in fields %}
                    <div class="field">
                        <div class="heading"><label>{{ field.label }}</label></div>
                        <div class="input">{{ field.value }}</div>
                    </div>
                {% endfor %}
                {% if canRelease and hold.active %}
                    <div class="field">
                        <div class="heading"><label>{{ 'Actions'|t('sms-manager') }}</label></div>
                        <div class="input">
                            <button type="button" class="btn fullwidth sms-release-hold" data-action="release-transport-hold" data-handle="{{ providerHandle }}" data-lane="{{ hold.lane }}" data-lane-label="{{ transportLabels.lane(hold.lane)|trim }}" data-token="{{ hold.token }}">{{ 'Release hold'|t('sms-manager') }}</button>
                        </div>
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    {% endif %}
</fieldset>
{% if canRelease %}
    {% include 'sms-manager/_components/_transport-release-script' only %}
{% endif %}
