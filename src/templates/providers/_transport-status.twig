<section id="mpp-transport-status" aria-labelledby="mpp-transport-title">
    <hr>
    <h2 id="mpp-transport-title">{{ 'Transport Status'|t('sms-manager') }}</h2>
    {% include 'lindemannrock-base/_components/info-box' with {
        message: 'Account holds require manual release. IP holds expire automatically when a recovery time is shown. Releasing a hold does not send or retry messages.'|t('sms-manager'),
        type: 'info',
        allowHtml: false,
    } only %}
    {% if not transportStatus.available %}
        {% include 'lindemannrock-base/_components/info-box' with {
            message: 'Transport status is unavailable. MPP sending remains blocked until guard storage is available.'|t('sms-manager'),
            type: 'error',
            allowHtml: false,
        } only %}
    {% elseif transportStatus.holds is empty %}
        <p>{{ 'No active holds'|t('sms-manager') }}</p>
    {% else %}
        {% set typeLabels = {
            'account-unavailable': 'Account unavailable'|t('sms-manager'),
            'ip-blocked': 'IP blocked'|t('sms-manager'),
            'admission-uncertain': 'In-flight or interrupted request'|t('sms-manager'),
        } %}
        {% set laneLabels = {
            'main': 'Main account'|t('sms-manager'),
            'development': 'Development account'|t('sms-manager'),
            'transport': 'All MPP accounts'|t('sms-manager'),
        } %}
        <table class="data fullwidth">
            <thead><tr>
                <th>{{ 'Hold type'|t('sms-manager') }}</th>
                <th>{{ 'Account'|t('sms-manager') }}</th>
                <th>{{ 'Activated at'|t('sms-manager') }}</th>
                <th>{{ 'Automatic recovery'|t('sms-manager') }}</th>
                <th>{{ 'Status'|t('sms-manager') }}</th>
                {% if canRelease %}<th><span class="visually-hidden">{{ 'Actions'|t('sms-manager') }}</span></th>{% endif %}
            </tr></thead>
            <tbody>
                {% for hold in transportStatus.holds %}
                    <tr>
                        <td>{{ typeLabels[hold.type] }}</td>
                        <td>{{ laneLabels[hold.lane] }}</td>
                        <td>{{ hold.activatedAt|lrDatetime }}</td>
                        <td>{{ hold.recoveryAt ? hold.recoveryAt|lrDatetime : 'Manual release required'|t('sms-manager') }}</td>
                        <td>{{ hold.active ? 'Active'|t('sms-manager') : 'Expired'|t('sms-manager') }}</td>
                        {% if canRelease %}
                            <td>{% if hold.active %}<button type="button" class="btn mpp-release-hold" data-lane="{{ hold.lane }}" data-token="{{ hold.token }}">{{ 'Release hold'|t('sms-manager') }}</button>{% endif %}</td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</section>
{% if canRelease %}
    {% js %}
    document.querySelectorAll('#mpp-transport-status .mpp-release-hold').forEach((button) => {
        button.addEventListener('click', async () => {
            if (!window.confirm({{ 'Release this hold? Confirm the account issue is resolved. For an interrupted request, stop all sending processes first. This action sends nothing.'|t('sms-manager')|json_encode|raw }})) return;
            button.disabled = true;
            try {
                const response = await Craft.sendActionRequest('POST', 'sms-manager/providers/release-transport-hold', {
                    data: {handle: {{ providerHandle|json_encode|raw }}, lane: button.dataset.lane, token: button.dataset.token, confirmed: '1'},
                });
                if (response.data.success) {
                    Craft.cp.displayNotice(response.data.message);
                    window.location.reload();
                } else {
                    Craft.cp.displayError(response.data.message);
                }
            } catch (error) {
                Craft.cp.displayError(error?.response?.data?.message);
            } finally {
                button.disabled = false;
            }
        });
    });
    {% endjs %}
{% endif %}
