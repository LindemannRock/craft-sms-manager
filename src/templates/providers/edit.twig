{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}
{% do view.registerAssetBundle('lindemannrock\\base\\web\\assets\\components\\ComponentsAsset') %}

{% set plugin = craft.app.plugins.getPlugin('sms-manager') %}
{% set canEdit = provider ? provider.canEdit() : true %}
{% set title = isNew ? 'New Provider'|t('sms-manager') : provider.name %}
{% set fullPageForm = canEdit %}
{% set selectedSubnavItem = 'providers' %}
{% set saveShortcutRedirect = cpUrl('sms-manager/providers/{id}') %}
{% set retainScrollOnSaveShortcut = true %}
{% set errorSummary = '' %}

{% set crumbs = [
    { label: smsHelper.fullName, url: url('sms-manager') },
    { label: 'Providers'|t('sms-manager'), url: url('sms-manager/providers') },
    { label: isNew ? 'New Provider'|t('sms-manager') : provider.name }
] %}

{# Set up tabs #}
{% if canEdit %}
    {% set tabs = {
        fields: {
            label: 'Settings'|t('sms-manager'),
            url: '#fields',
        },
    } %}
{% endif %}

{% if provider and provider.hasErrors() %}
    {% set errorSummary = include('lindemannrock-base/_partials/error-summary', {
        errors: provider.getErrors(),
        linkMode: 'data-key',
        translationCategory: 'sms-manager'
    })|trim %}
{% endif %}

{% block actionButton %}
    {% if canEdit %}
        <div class="btngroup submit">
            <button type="submit" class="btn submit">{{ "Save"|t('sms-manager') }}</button>
            <button type="button" class="btn submit menubtn"></button>
            <div class="menu">
                <ul role="listbox">
                    <li>
                        <a class="formsubmit" role="option" tabindex="0" data-redirect="{{ cpUrl('sms-manager/providers/{id}')|hash }}">
                            <span class="label">{{ 'Save and continue editing'|t('sms-manager') }}</span>
                            <span class="shortcut" id="save-shortcut"></span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
        {% set isDefault = provider and defaultProviderHandle == provider.handle %}
        {% if not isNew and currentUser.can('smsManager:deleteProviders') and not isDefault %}
            <button type="button" id="action-btn" class="btn menubtn action-btn hairline-dark m" title="{{ 'Actions'|t('sms-manager') }}" aria-controls="action-menu" aria-label="{{ 'Actions'|t('sms-manager') }}" data-disclosure-trigger="true" aria-expanded="false"></button>
            <div id="action-menu" class="menu menu--disclosure">
                <ul>
                    <li>
                        <button class="menu-item error formsubmit" data-destructive data-action="sms-manager/providers/delete" data-params='{"providerId":{{ provider.id }}}' data-confirm="{{ 'Are you sure you want to delete this provider?'|t('sms-manager') }}" data-redirect="{{ 'sms-manager/providers'|hash }}">
                            <span class="icon">{{ svg('@app/icons/trash.svg') }}</span>
                            <span class="menu-item-label">{{ "Delete"|t('sms-manager') }}</span>
                        </button>
                    </li>
                </ul>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}

{% block content %}
    {% if canEdit %}
        {# Editable form for database providers #}
        <input type="hidden" name="action" value="sms-manager/providers/save">
        <input type="hidden" name="redirect" value="{{ 'sms-manager/providers'|hash }}">
        {% if not isNew %}
            <input type="hidden" name="providerId" value="{{ provider.id }}">
        {% endif %}
        {{ csrfInput() }}

        <div id="fields">
            {{ forms.textField({
                first: true,
                label: 'Name'|t('sms-manager'),
                instructions: 'The name of this provider'|t('sms-manager'),
                id: 'name',
                name: 'name',
                value: provider.name ?? '',
                required: true,
                errors: provider ? provider.getErrors('name') : [],
            }) }}

            {{ forms.textField({
                label: 'Handle'|t('sms-manager'),
                instructions: 'How you will refer to this provider in code'|t('sms-manager'),
                id: 'handle',
                name: 'handle',
                class: 'code',
                value: provider.handle ?? '',
                errors: provider ? provider.getErrors('handle') : [],
            }) }}

            {{ forms.selectField({
                label: 'Provider Type'|t('sms-manager'),
                instructions: 'The SMS provider type'|t('sms-manager'),
                id: 'type',
                name: 'type',
                value: provider.type ?? 'mpp-sms',
                options: providerTypes,
                required: true,
            }) }}

            <hr>

            <h2>{{ 'Provider Settings'|t('sms-manager') }}</h2>

            {# Each provider renders its own getSettingsHtml(); the type dropdown swaps it via the render-settings action. #}
            <div id="provider-settings">
                {{ settingsHtml|raw }}
            </div>
        </div>
    {% else %}
        {# Read-only view for config providers #}
        <div class="pane">
            <h2>{{ 'Configuration'|t('sms-manager') }}</h2>
            <p class="light">{{ 'This provider is defined in your config file and cannot be edited here.'|t('sms-manager') }}</p>
            {% if provider.rawConfigDisplay %}
                <pre style="background: #f3f7fc; padding: 14px; border-radius: 4px; overflow-x: auto; font-size: 12px;"><code>{{ provider.rawConfigDisplay }}</code></pre>
            {% endif %}
        </div>
    {% endif %}

    {% include 'lindemannrock-base/_components/plugin-credit' %}
{% endblock %}

{% block details %}
    {% set isDefault = provider and defaultProviderHandle == provider.handle %}
    {% set isFirstProvider = isNew and (providerCount ?? 0) == 0 %}

    <div class="meta">
        {# Enabled toggle #}
        {% if canEdit %}
            {% if isDefault %}
                {{ forms.lightswitchField({
                    label: 'Enabled'|t('sms-manager'),
                    instructions: 'Default provider cannot be disabled.'|t('sms-manager'),
                    id: 'enabled',
                    name: 'enabled',
                    on: true,
                    disabled: true
                }) }}
                <input type="hidden" name="enabled" value="1">
            {% elseif isFirstProvider %}
                {{ forms.lightswitchField({
                    label: 'Enabled'|t('sms-manager'),
                    instructions: 'First provider must be enabled.'|t('sms-manager'),
                    id: 'enabled',
                    name: 'enabled',
                    on: true,
                    disabled: true
                }) }}
                <input type="hidden" name="enabled" value="1">
            {% else %}
                {{ forms.lightswitchField({
                    label: 'Enabled'|t('sms-manager'),
                    id: 'enabled',
                    name: 'enabled',
                    on: provider.enabled ?? true
                }) }}
            {% endif %}
        {% else %}
            {# Config provider - show as read-only #}
            {{ forms.lightswitchField({
                label: 'Enabled'|t('sms-manager'),
                instructions: 'Set via config/sms-manager.php. Edit the file to change.'|t('sms-manager'),
                id: 'enabled',
                on: provider.enabled ?? true,
                disabled: true
            }) }}
        {% endif %}

        {# Default toggle - shown for all providers (config or database) #}
        {% if not isNew %}
            {% if not canEdit %}
                {# Config provider - show as read-only #}
                {{ forms.lightswitchField({
                    label: 'Default Provider'|t('sms-manager'),
                    instructions: 'Set via config/sms-manager.php. Edit the file to change.'|t('sms-manager'),
                    id: 'isDefault',
                    on: isDefault,
                    disabled: true
                }) }}
            {% elseif isDefaultFromConfig %}
                {# Default is set via config - disable for ALL providers #}
                {{ forms.lightswitchField({
                    label: 'Default Provider'|t('sms-manager'),
                    instructions: 'Set via config/sms-manager.php. Edit the file to change.'|t('sms-manager'),
                    id: 'isDefault',
                    on: isDefault,
                    disabled: true
                }) }}
            {% elseif isDefault %}
                {# This is the current default (not from config) #}
                {{ forms.lightswitchField({
                    label: 'Default Provider'|t('sms-manager'),
                    instructions: 'To change, set another provider as default first.'|t('sms-manager'),
                    id: 'isDefault',
                    name: 'isDefault',
                    on: true,
                    disabled: true
                }) }}
                {% if canEdit %}
                    <input type="hidden" name="isDefault" value="1">
                {% endif %}
            {% elseif canEdit or currentUser.can('smsManager:editProviders') %}
                {# Can toggle default: form submission for database, AJAX for config #}
                {{ forms.lightswitchField({
                    label: 'Default Provider'|t('sms-manager'),
                    instructions: 'Use this provider when no specific provider is specified.'|t('sms-manager'),
                    id: 'isDefault',
                    name: 'isDefault',
                    on: false
                }) }}
            {% endif %}
        {% elseif isFirstProvider %}
            {{ forms.lightswitchField({
                label: 'Default Provider'|t('sms-manager'),
                instructions: 'First provider is automatically set as default.'|t('sms-manager'),
                id: 'isDefault',
                name: 'isDefault',
                on: true,
                disabled: true
            }) }}
            <input type="hidden" name="isDefault" value="1">
        {% endif %}
    </div>

    {% if not isNew and providerMeta is defined and providerMeta %}
        <fieldset>
            <legend class="h6">{{ 'Provider Info'|t('sms-manager') }}</legend>
            <div class="meta">
                {% if providerMeta.website %}
                    <div class="field">
                        <div class="heading"><label>{{ 'Website'|t('sms-manager') }}</label></div>
                        <div class="input"><a href="{{ providerMeta.website }}" target="_blank" rel="noopener">{{ providerMeta.website|replace({'https://www.': '', 'https://': ''}) }}</a></div>
                    </div>
                {% endif %}
                {% if providerMeta.docsUrl %}
                    <div class="field">
                        <div class="heading"><label>{{ 'API Docs'|t('sms-manager') }}</label></div>
                        <div class="input"><a href="{{ providerMeta.docsUrl }}" target="_blank" rel="noopener">{{ 'View Docs'|t('sms-manager') }}</a></div>
                    </div>
                {% endif %}
                {% if providerMeta.dashboardUrl %}
                    <div class="field">
                        <div class="heading"><label>{{ 'Dashboard'|t('sms-manager') }}</label></div>
                        <div class="input"><a href="{{ providerMeta.dashboardUrl }}" target="_blank" rel="noopener">{{ 'Open Dashboard'|t('sms-manager') }}</a></div>
                    </div>
                {% endif %}
                <div class="field">
                    <div class="heading"><label>{{ 'Unicode'|t('sms-manager') }}</label></div>
                    <div class="input">
                        {% include 'lindemannrock-base/_components/status-dot' with {
                            value: providerMeta.supportsUnicode ? 'yes' : 'no',
                            colorSet: 'yesNo',
                        } only %}
                        <span>{{ providerMeta.supportsUnicode ? 'Supported'|t('sms-manager') : 'Not Supported'|t('sms-manager') }}</span>
                    </div>
                </div>
                <div class="field">
                    <div class="heading"><label>{{ 'Delivery Reports'|t('sms-manager') }}</label></div>
                    <div class="input">
                        {% include 'lindemannrock-base/_components/status-dot' with {
                            value: providerMeta.supportsDeliveryReports ? 'yes' : 'no',
                            colorSet: 'yesNo',
                        } only %}
                        <span>{{ providerMeta.supportsDeliveryReports ? 'Supported'|t('sms-manager') : 'Not Supported'|t('sms-manager') }}</span>
                    </div>
                </div>
            </div>
        </fieldset>
    {% endif %}

    {% if not isNew %}
    <fieldset>
        <dl class="meta read-only">
            {% if canEdit %}
                <div class="data">
                    <dt class="heading">{{ 'ID'|t('sms-manager') }}</dt>
                    <dd class="value">{{ provider.id }}</dd>
                </div>
            {% endif %}
	            <div class="data">
	                <dt class="heading">{{ 'Status'|t('sms-manager') }}</dt>
	                <dd class="value">
	                    {% include 'lindemannrock-base/_components/status-dot' with {
	                        value: provider.enabled ? 'enabled' : 'disabled',
	                        colorSet: 'status',
	                    } only %}
	                    <span>{{ provider.enabled ? 'Enabled'|t('sms-manager') : 'Disabled'|t('sms-manager') }}</span>
	                </dd>
	            </div>
            <div class="data">
                <dt class="heading">{{ 'Handle'|t('sms-manager') }}</dt>
                <dd class="value"><code>{{ provider.handle }}</code></dd>
            </div>
            <div class="data">
                <dt class="heading">{{ 'Type'|t('sms-manager') }}</dt>
                <dd class="value">
                    {% include 'lindemannrock-base/_components/status-dot' with {
                        value: provider.type,
                        colorSet: 'smsProviderType',
                    } only %}
                    <span>{{ provider.type|upper }}</span>
                </dd>
            </div>
            <div class="data">
                <dt class="heading">{{ 'Source'|t('sms-manager') }}</dt>
                <dd class="value">
                    {% include 'lindemannrock-base/_components/status-dot' with {
                        value: provider.source,
                        colorSet: 'configSource',
                    } only %}
                    <span>{{ provider.source == 'config' ? 'Config File'|t('sms-manager') : 'Database'|t('sms-manager') }}</span>
                </dd>
            </div>
            {% if isDefault %}
                <div class="data">
                    <dt class="heading">{{ 'Default'|t('sms-manager') }}</dt>
                    <dd class="value">
                        {% include 'lindemannrock-base/_components/status-dot' with {
                            value: 'yes',
                            colorSet: 'yesNo',
                        } only %}
                        <span>{{ 'Yes'|t('sms-manager') }}</span>
                    </dd>
                </div>
            {% endif %}
            {% if canEdit %}
                {# Config providers don't have database timestamps #}
                <div class="data">
                    <dt class="heading">{{ 'Created at'|t('sms-manager') }}</dt>
                    <dd class="value">{{ provider.dateCreated|lrDatetime }}</dd>
                </div>
                <div class="data">
                    <dt class="heading">{{ 'Updated at'|t('sms-manager') }}</dt>
                    <dd class="value">{{ provider.dateUpdated|lrDatetime }}</dd>
                </div>
            {% endif %}
        </dl>
    </fieldset>
    {% endif %}

{% endblock %}

{% if canEdit %}
{% js %}
window.lrIdentifiers?.bindSlugHandle('#name', '#handle', {
    isNew: {{ isNew ? 'true' : 'false' }},
});

// Provider type switching — fetch the selected type's own settings form
// (mirrors Craft core's fields/render-settings). The current type is already
// server-rendered into #provider-settings on load.
const typeSelect = document.getElementById('type');
const settingsContainer = document.getElementById('provider-settings');
const editProviderId = {{ (provider.id ?? null)|json_encode|raw }};

if (typeSelect && settingsContainer) {
    typeSelect.addEventListener('change', function() {
        settingsContainer.innerHTML = '<div class="zilch"><div class="spinner"></div></div>';

        Craft.sendActionRequest('POST', 'sms-manager/providers/render-settings', {
            data: { type: this.value, providerId: editProviderId },
        }).then((response) => {
            settingsContainer.innerHTML = response.data.settingsHtml || '';
            Craft.appendHeadHtml(response.data.headHtml);
            Craft.appendBodyHtml(response.data.bodyHtml);
            Craft.initUiElements(settingsContainer);
        }).catch((e) => {
            Craft.cp.displayError(e?.response?.data?.message);
            settingsContainer.innerHTML = '';
        });
    });
}

// Set platform-specific keyboard shortcut
const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
const saveShortcut = document.getElementById('save-shortcut');
if (saveShortcut) {
    saveShortcut.textContent = isMac ? '⌘S' : 'Ctrl+S';
}
{% endjs %}
{% endif %}
