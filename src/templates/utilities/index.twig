{% extends 'lindemannrock-base/_layouts/cp-utilities' %}

{# Permission checks #}
{% set canManageProviders = currentUser.can('smsManager:manageProviders') %}
{% set canManageSenderIds = currentUser.can('smsManager:manageSenderIds') %}
{% set canViewAnalytics = currentUser.can('smsManager:viewAnalytics') %}
{% set canClearAnalytics = currentUser.can('smsManager:clearAnalytics') %}
{% set canViewLogs = currentUser.can('smsManager:viewSmsLogs') %}
{% set canClearLogs = currentUser.can('smsManager:deleteSmsLogs') %}
{% set canManageSettings = currentUser.can('smsManager:manageSettings') %}

{% set hasNavigation = canManageProviders or canManageSenderIds or (settings.enableAnalytics and canViewAnalytics) or (settings.enableSmsLogs and canViewLogs) or canManageSettings %}
{% set hasAnalyticsManagement = canClearAnalytics and settings.enableAnalytics %}
{% set hasLogsManagement = canClearLogs and settings.enableSmsLogs %}
{% set hasAnyQuickAction = hasNavigation or hasAnalyticsManagement or hasLogsManagement %}

{% set utilitiesConfig = {
    plugin: {
        handle: 'sms-manager',
        name: smsHelper.fullName,
    },
    page: {
        title: 'Overview'|t('sms-manager'),
        description: 'Manage SMS providers, sender IDs, and clear analytics data.'|t('sms-manager'),
    },
} %}

{% block overview %}
    {# Providers Card #}
    {% if canManageProviders %}
    {% include 'lindemannrock-base/_components/unified-card' with {
        title: 'SMS Providers'|t('sms-manager'),
        color: lrPaletteColor('emerald').color,
        value: providersCount,
        valueColor: lrPaletteColor('emerald').color,
        badge: activeProviders > 0 ? 'Active'|t('sms-manager') : 'None Active'|t('sms-manager'),
        badgeColor: activeProviders > 0 ? lrPaletteColor('emerald').color : lrPaletteColor('gray').color,
        description: 'Total providers configured'|t('sms-manager'),
        subBoxes: [
            {value: activeProviders, label: 'Active Providers'|t('sms-manager')},
        ],
    } only %}
    {% endif %}

    {# Sender IDs Card #}
    {% if canManageSenderIds %}
    {% include 'lindemannrock-base/_components/unified-card' with {
        title: 'Sender IDs'|t('sms-manager'),
        color: lrPaletteColor('sky').color,
        value: senderIdsCount,
        valueColor: lrPaletteColor('sky').color,
        badge: activeSenderIds > 0 ? 'Active'|t('sms-manager') : 'None Active'|t('sms-manager'),
        badgeColor: activeSenderIds > 0 ? lrPaletteColor('sky').color : lrPaletteColor('gray').color,
        description: 'Total sender IDs configured'|t('sms-manager'),
        subBoxes: [
            {value: activeSenderIds, label: 'Active Sender IDs'|t('sms-manager')},
        ],
    } only %}
    {% endif %}

    {# Analytics & Logs Card #}
    {% if settings.enableAnalytics and settings.enableSmsLogs and canViewAnalytics and canViewLogs %}
        {% include 'lindemannrock-base/_components/unified-card' with {
            title: 'Analytics & Logs'|t('sms-manager'),
            color: lrPaletteColor('violet').color,
            value: totalSent + totalFailed,
            description: 'SMS tracking and message logs'|t('sms-manager'),
            subBoxes: [
                {value: totalSent, label: 'Sent'|t('sms-manager'), color: lrPaletteColor('emerald').color},
                {value: totalFailed, label: 'Failed'|t('sms-manager'), color: lrPaletteColor('red').color},
                {value: logsCount, label: 'Logs'|t('sms-manager'), color: lrPaletteColor('amber').color},
            ],
        } only %}
    {% endif %}
{% endblock %}

{% block quickActions %}
    {% if hasAnyQuickAction %}
        {# Navigation Section #}
        {% if hasNavigation %}
            {% set navButtons = [] %}
            {% if canManageProviders %}
                {% set navButtons = navButtons|merge([{type: 'link', label: 'Manage Providers'|t('sms-manager'), url: url('sms-manager/providers')}]) %}
            {% endif %}
            {% if canManageSenderIds %}
                {% set navButtons = navButtons|merge([{type: 'link', label: 'Manage Sender IDs'|t('sms-manager'), url: url('sms-manager/sender-ids')}]) %}
            {% endif %}
            {% if canManageSettings %}
                {% set navButtons = navButtons|merge([{type: 'link', label: 'Manage Settings'|t('sms-manager'), url: url('sms-manager/settings')}]) %}
            {% endif %}
            {% if settings.enableAnalytics and canViewAnalytics %}
                {% set navButtons = navButtons|merge([{type: 'link', label: 'View Analytics'|t('sms-manager'), url: url('sms-manager/analytics')}]) %}
            {% endif %}
            {% if settings.enableSmsLogs and canViewLogs %}
                {% set navButtons = navButtons|merge([{type: 'link', label: 'View SMS Logs'|t('sms-manager'), url: url('sms-manager/sms-logs')}]) %}
            {% endif %}

            {% include 'lindemannrock-base/_layouts/cp-utilities/_action-section' with {
                title: 'Navigation'|t('sms-manager'),
                description: 'Access main plugin sections'|t('sms-manager'),
                buttons: navButtons,
            } only %}
        {% endif %}

        {# Analytics Management Section #}
        {% if hasAnalyticsManagement %}
            {% include 'lindemannrock-base/_layouts/cp-utilities/_action-section' with {
                title: 'Analytics Data Management'|t('sms-manager'),
                description: 'Permanently delete all SMS analytics data. This action cannot be undone!'|t('sms-manager'),
                showSeparator: hasNavigation,
                buttons: [
                    {id: 'clear-all-analytics', label: 'Clear All Analytics'|t('sms-manager'), class: 'btn secondary', count: analyticsCount},
                ],
            } only %}
        {% endif %}

        {# Logs Management Section #}
        {% if hasLogsManagement %}
            {% include 'lindemannrock-base/_layouts/cp-utilities/_action-section' with {
                title: 'SMS Logs Management'|t('sms-manager'),
                description: 'Permanently delete all SMS logs. This action cannot be undone!'|t('sms-manager'),
                showSeparator: hasNavigation or hasAnalyticsManagement,
                buttons: [
                    {id: 'clear-all-logs', label: 'Clear All SMS Logs'|t('sms-manager'), class: 'btn secondary', count: logsCount},
                ],
            } only %}
        {% endif %}
    {% endif %}
{% endblock %}

{% block scripts %}
{% js %}
{% if hasAnalyticsManagement %}
{% include 'lindemannrock-base/_layouts/cp-utilities/_ajax-button' with {
    id: 'clear-all-analytics',
    action: actionUrl('sms-manager/utilities/clear-all-analytics'),
    confirm: 'Are you sure you want to permanently delete ALL analytics data? This action cannot be undone!'|t('sms-manager'),
    confirmSecond: 'This will delete all SMS tracking data and reset all statistics. Are you absolutely sure?'|t('sms-manager'),
    errorMessage: 'Failed to clear analytics'|t('sms-manager'),
    reloadDelay: 2000,
} only %}
{% endif %}

{% if hasLogsManagement %}
{% include 'lindemannrock-base/_layouts/cp-utilities/_ajax-button' with {
    id: 'clear-all-logs',
    action: actionUrl('sms-manager/utilities/clear-all-logs'),
    confirm: 'Are you sure you want to permanently delete ALL SMS logs? This action cannot be undone!'|t('sms-manager'),
    confirmSecond: 'This will delete all SMS log entries. Are you absolutely sure?'|t('sms-manager'),
    errorMessage: 'Failed to clear SMS logs'|t('sms-manager'),
    reloadDelay: 2000,
} only %}
{% endif %}
{% endjs %}
{% endblock %}
