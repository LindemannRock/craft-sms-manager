{#
 # SMS Manager Dashboard
 #
 # Overview page with stats, recent logs, and quick actions.
 #}

{% extends "_layouts/cp" %}
{% set title = smsHelper.fullName %}
{% set selectedSubnavItem = 'dashboard' %}

{% set crumbs = [
    { label: smsHelper.fullName, url: url('sms-manager') },
] %}

{# Permission checks #}
{% set canViewSmsLogs = currentUser.can('smsManager:viewSmsLogs') %}
{% set canViewProviders = currentUser.can('smsManager:viewProviders') %}
{% set canViewSenderIds = currentUser.can('smsManager:viewSenderIds') %}
{% set canViewAnalytics = currentUser.can('smsManager:viewAnalytics') %}
{% set canCreateProviders = currentUser.can('smsManager:createProviders') %}
{% set canCreateSenderIds = currentUser.can('smsManager:createSenderIds') %}
{% set canManageSettings = currentUser.can('smsManager:manageSettings') %}

{% block content %}

<div class="readable" style="margin-bottom: 24px;">
    <p>{{ "SMS gateway and management with multi-provider support"|t('sms-manager') }}</p>
</div>

{# Stats Overview Cards #}
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 32px;">
    {# SMS Today Card #}
    {% if canViewSmsLogs and settings.enableSmsLogs %}
    <a href="{{ url('sms-manager/logs/sms') }}" class="pane" style="padding: 24px; margin-block: 0; background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); text-decoration: none; display: block;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
            <div style="width: 12px; height: 12px; border-radius: 50%; background: #0ea5e9;"></div>
            <h4 style="margin: 0; color: #374151; font-size: 14px; font-weight: 600;">{{ "SMS Today"|t('sms-manager') }}</h4>
        </div>
        <div style="display: flex; align-items: baseline; gap: 8px; margin-bottom: 8px;">
            <div style="font-size: 32px; font-weight: 700; color: #0ea5e9; line-height: 1;">{{ smsToday|number_format }}</div>
            {% if smsYesterday > 0 %}
                {% set change = ((smsToday - smsYesterday) / smsYesterday * 100)|round %}
                <div style="font-size: 13px; padding: 2px 8px; border-radius: 12px; background: {{ change >= 0 ? '#dcfce7' : '#fee2e2' }}; color: {{ change >= 0 ? '#166534' : '#991b1b' }};">
                    {{ change >= 0 ? '+' : '' }}{{ change|number_format }}%
                </div>
            {% endif %}
        </div>
        <div style="font-size: 13px; color: #6b7280;">{{ smsYesterday|number_format }} {{ "yesterday"|t('sms-manager') }}</div>
    </a>
    {% endif %}

    {# Success Rate Card #}
    {% if canViewSmsLogs and settings.enableSmsLogs %}
    <a href="{{ url('sms-manager/logs/sms') }}" class="pane" style="padding: 24px; margin-block: 0; background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); text-decoration: none; display: block;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
            <div style="width: 12px; height: 12px; border-radius: 50%; background: #059669;"></div>
            <h4 style="margin: 0; color: #374151; font-size: 14px; font-weight: 600;">{{ "Success Rate"|t('sms-manager') }}</h4>
        </div>
        <div style="display: flex; align-items: baseline; gap: 8px; margin-bottom: 8px;">
            <div style="font-size: 32px; font-weight: 700; color: #059669; line-height: 1;">{{ successRate }}%</div>
        </div>
        <div style="font-size: 13px; color: #6b7280;">{{ "Last 7 days"|t('sms-manager') }}</div>
    </a>
    {% endif %}

    {# Failed Today Card #}
    {% if canViewSmsLogs and settings.enableSmsLogs %}
    <a href="{{ url('sms-manager/logs/sms') }}?status=failed" class="pane" style="padding: 24px; margin-block: 0; background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); text-decoration: none; display: block;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
            <div style="width: 12px; height: 12px; border-radius: 50%; background: {{ failedToday > 0 ? '#ef4444' : '#9ca3af' }};"></div>
            <h4 style="margin: 0; color: #374151; font-size: 14px; font-weight: 600;">{{ "Failed Today"|t('sms-manager') }}</h4>
        </div>
        <div style="display: flex; align-items: baseline; gap: 8px; margin-bottom: 8px;">
            <div style="font-size: 32px; font-weight: 700; color: {{ failedToday > 0 ? '#ef4444' : '#9ca3af' }}; line-height: 1;">{{ failedToday|number_format }}</div>
        </div>
        <div style="font-size: 13px; color: #6b7280;">{{ "messages failed"|t('sms-manager') }}</div>
    </a>
    {% endif %}

    {# Providers Card #}
    {% if canViewProviders %}
    <a href="{{ url('sms-manager/providers') }}" class="pane" style="padding: 24px; margin-block: 0; background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); text-decoration: none; display: block;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
            <div style="width: 12px; height: 12px; border-radius: 50%; background: #8b5cf6;"></div>
            <h4 style="margin: 0; color: #374151; font-size: 14px; font-weight: 600;">{{ "Providers"|t('sms-manager') }}</h4>
        </div>
        <div style="display: flex; align-items: baseline; gap: 8px; margin-bottom: 8px;">
            <div style="font-size: 32px; font-weight: 700; color: #8b5cf6; line-height: 1;">{{ enabledProviders|number_format }}</div>
            {% if totalProviders > enabledProviders %}
                <div style="font-size: 14px; color: #6b7280;">/ {{ totalProviders|number_format }}</div>
            {% endif %}
        </div>
        <div style="font-size: 13px; color: #6b7280;">{{ "active providers"|t('sms-manager') }}</div>
    </a>
    {% endif %}
</div>

{# Recent SMS Logs #}
{% if canViewSmsLogs and settings.enableSmsLogs %}
<div class="pane" style="margin-bottom: 32px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 style="margin: 0;">{{ "Recent SMS"|t('sms-manager') }}</h3>
        <span style="font-size: 12px; color: #6b7280;">{{ "Latest messages"|t('sms-manager') }}</span>
    </div>

    {% if recentLogs|length %}
        <table class="data fullwidth" style="margin: 0;">
            <thead>
                <tr>
                    <th>{{ "Recipient"|t('sms-manager') }}</th>
                    <th>{{ "Message"|t('sms-manager') }}</th>
                    <th>{{ "Status"|t('sms-manager') }}</th>
                    <th style="text-align: right;">{{ "Sent"|t('sms-manager') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for log in recentLogs %}
                    <tr>
                        <td style="padding: 12px 0; border-bottom: 1px solid #e5e7eb;">
                            <code style="font-family: monospace; font-size: 13px;">{{ log.recipient }}</code>
                        </td>
                        <td style="padding: 12px 0; border-bottom: 1px solid #e5e7eb; max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="{{ log.message }}">
                            {{ log.message|slice(0, 50) }}{% if log.message|length > 50 %}...{% endif %}
                        </td>
                        <td style="padding: 12px 0; border-bottom: 1px solid #e5e7eb;">
                            {% include 'lindemannrock-base/_components/badge' with {
                                label: log.status|capitalize,
                                value: log.status,
                                colorSet: 'smsStatus',
                            } only %}
                        </td>
                        <td style="text-align: right; padding: 12px 0; border-bottom: 1px solid #e5e7eb; color: #6b7280; white-space: nowrap; font-size: 13px;">
                            {{ log.dateCreated|date('M j, g:i a') }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <div style="margin-top: 16px;">
            <a href="{{ url('sms-manager/logs/sms') }}" class="go">{{ "View all SMS logs"|t('sms-manager') }}</a>
        </div>
    {% else %}
        <p class="light" style="margin: 0;">{{ "No SMS logs yet"|t('sms-manager') }}</p>
    {% endif %}
</div>
{% endif %}

{# Quick Actions #}
{% set hasAnyQuickAction = canCreateProviders or canCreateSenderIds or canManageSettings or (settings.enableAnalytics and canViewAnalytics) %}
{% if hasAnyQuickAction %}
<div class="pane">
    <h2 style="margin-top: 0;">{{ "Quick Actions"|t('sms-manager') }}</h2>

    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        {% if canCreateProviders %}
            <a href="{{ url('sms-manager/providers/new') }}" class="btn submit">{{ "New Provider"|t('sms-manager') }}</a>
        {% endif %}
        {% if canCreateSenderIds %}
            <a href="{{ url('sms-manager/sender-ids/new') }}" class="btn">{{ "New Sender ID"|t('sms-manager') }}</a>
        {% endif %}
        {% if settings.enableAnalytics and canViewAnalytics %}
            <a href="{{ url('sms-manager/analytics') }}" class="btn">{{ "View Analytics"|t('sms-manager') }}</a>
        {% endif %}
        {% if canManageSettings %}
            <a href="{{ url('sms-manager/settings') }}" class="btn">{{ "Settings"|t('sms-manager') }}</a>
        {% endif %}
    </div>
</div>
{% endif %}

{% include 'lindemannrock-base/_components/plugin-credit' %}

{% endblock %}
