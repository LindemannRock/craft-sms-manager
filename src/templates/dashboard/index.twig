{#
 # SMS Manager Dashboard
 #
 # Overview page with stats, recent logs, and quick actions.
 #}

{% extends "_layouts/cp" %}
{% set title = smsHelper.fullName %}
{% set selectedSubnavItem = 'dashboard' %}

{% set crumbs = [
    { label: smsHelper.fullName, url: url('sms-manager') },
] %}

{# Permission checks #}
{% set canViewSmsLogs = currentUser.can('smsManager:viewSmsLogs') %}
{% set canViewProviders = currentUser.can('smsManager:manageProviders') %}
{% set canViewSenderIds = currentUser.can('smsManager:manageSenderIds') %}
{% set canViewAnalytics = currentUser.can('smsManager:viewAnalytics') %}
{% set canCreateProviders = currentUser.can('smsManager:createProviders') %}
{% set canCreateSenderIds = currentUser.can('smsManager:createSenderIds') %}
{% set canManageSettings = currentUser.can('smsManager:manageSettings') %}

{% block actionButton %}
    {% set hasAnyQuickAction = canCreateProviders or canCreateSenderIds or canManageSettings or (settings.enableAnalytics and canViewAnalytics) or (settings.enableSmsLogs and canViewSmsLogs) %}
    {% if hasAnyQuickAction %}
        <div class="btngroup">
            <button type="button" class="btn menubtn">{{ "Quick Actions"|t('sms-manager') }}</button>
            <div class="menu">
                <ul>
                    {% if canCreateProviders %}
                        <li><a href="{{ url('sms-manager/providers/new') }}">{{ "New Provider"|t('sms-manager') }}</a></li>
                    {% endif %}
                    {% if canCreateSenderIds %}
                        <li><a href="{{ url('sms-manager/sender-ids/new') }}">{{ "New Sender ID"|t('sms-manager') }}</a></li>
                    {% endif %}
                    {% if settings.enableSmsLogs and canViewSmsLogs %}
                        <li><a href="{{ url('sms-manager/logs/sms') }}">{{ "View SMS Logs"|t('sms-manager') }}</a></li>
                    {% endif %}
                    {% if settings.enableAnalytics and canViewAnalytics %}
                        <li><a href="{{ url('sms-manager/analytics') }}">{{ "View Analytics"|t('sms-manager') }}</a></li>
                    {% endif %}
                    {% if canManageSettings %}
                        <li><a href="{{ url('sms-manager/settings') }}">{{ "Settings"|t('sms-manager') }}</a></li>
                    {% endif %}
                </ul>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block content %}


{# Stats Overview Cards #}
<div class="lr-unified-cards" style="margin-bottom: 32px;">
    {# SMS Today Card #}
    {% if canViewSmsLogs and settings.enableSmsLogs %}
        {% set change = (smsToday > 0 and smsYesterday > 0) ? ((smsToday - smsYesterday) / smsYesterday * 100)|round : null %}
        {% include 'lindemannrock-base/_components/cards/unified-card' with {
            title: 'SMS Today'|t('sms-manager'),
            color: '#0ea5e9',
            value: smsToday,
            badge: change is not null ? ((change >= 0 ? '+' : '') ~ change ~ '%') : null,
            badgeType: change is not null ? (change >= 0 ? 'positive' : 'negative') : 'default',
            description: (smsYesterday|number_format) ~ ' ' ~ 'yesterday'|t('sms-manager'),
            url: url('sms-manager/logs/sms'),
        } only %}
    {% endif %}

    {# Success Rate Card #}
    {% if canViewSmsLogs and settings.enableSmsLogs %}
        {% include 'lindemannrock-base/_components/cards/unified-card' with {
            title: 'Success Rate'|t('sms-manager'),
            color: '#059669',
            value: successRate ~ '%',
            description: 'Last 7 days'|t('sms-manager'),
            url: url('sms-manager/logs/sms'),
        } only %}
    {% endif %}

    {# Failed Today Card #}
    {% if canViewSmsLogs and settings.enableSmsLogs %}
        {% include 'lindemannrock-base/_components/cards/unified-card' with {
            title: 'Failed Today'|t('sms-manager'),
            color: failedToday > 0 ? '#ef4444' : '#9ca3af',
            value: failedToday,
            description: 'messages failed'|t('sms-manager'),
            url: url('sms-manager/logs/sms') ~ '?status=failed',
        } only %}
    {% endif %}

    {# Providers Card #}
    {% if canViewProviders %}
        {% include 'lindemannrock-base/_components/cards/unified-card' with {
            title: 'Providers'|t('sms-manager'),
            color: '#8b5cf6',
            value: enabledProviders,
            secondary: totalProviders > enabledProviders ? totalProviders : null,
            description: 'active providers'|t('sms-manager'),
            url: url('sms-manager/providers'),
        } only %}
    {% endif %}
</div>

{# Recent SMS Logs #}
{% if canViewSmsLogs and settings.enableSmsLogs %}
<h3 style="margin-bottom: 12px;">{{ "Recent SMS"|t('sms-manager') }} <span style="font-weight: normal;">({{ "Latest {count}"|t('sms-manager', { count: recentLogs|length }) }})</span></h3>
<div class="pane" style="margin-bottom: 32px;">
    {% if recentLogs|length %}
        <table class="data fullwidth" style="margin: 0;">
            <thead>
                <tr>
                    <th style="padding: 0 0 12px 0;">{{ "Recipient"|t('sms-manager') }}</th>
                    <th style="padding: 0 0 12px 0;">{{ "Message"|t('sms-manager') }}</th>
                    <th style="padding: 0 0 12px 0;">{{ "Status"|t('sms-manager') }}</th>
                    <th style="text-align: right; padding: 0 0 12px 0;">{{ "Sent"|t('sms-manager') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for log in recentLogs %}
                    <tr>
                        <td style="padding: 12px 0; border-bottom: 1px solid #e5e7eb;">
                            <code style="font-family: monospace; font-size: 13px;">{{ log.recipient }}</code>
                        </td>
                        <td style="padding: 12px 0; border-bottom: 1px solid #e5e7eb; max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="{{ log.message }}">
                            {{ log.message|slice(0, 50) }}{% if log.message|length > 50 %}...{% endif %}
                        </td>
                        <td style="padding: 12px 0; border-bottom: 1px solid #e5e7eb;">
                            {% include 'lindemannrock-base/_components/badge' with {
                                label: log.status|capitalize,
                                value: log.status,
                                colorSet: 'smsStatus',
                            } only %}
                        </td>
                        <td style="text-align: right; padding: 12px 0; padding-right: 0; border-bottom: 1px solid #e5e7eb; color: #6b7280; white-space: nowrap; font-size: 13px;">
                            {{ log.dateCreated|lrDatetime('medium') }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <div style="margin-top: 16px;">
            <a href="{{ url('sms-manager/logs/sms') }}" class="go">{{ "View all SMS logs"|t('sms-manager') }}</a>
        </div>
    {% else %}
        <p class="light" style="margin: 0;">{{ "No SMS logs yet"|t('sms-manager') }}</p>
    {% endif %}
</div>
{% endif %}

{% include 'lindemannrock-base/_components/plugin-credit' %}

{% endblock %}
