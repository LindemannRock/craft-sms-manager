{% js %}
document.addEventListener('click', async (event) => {
    const trigger = event.target.closest?.('[data-action="release-transport-hold"]');
    if (!trigger) return;
    event.preventDefault();
    if (trigger.dataset.releasing === '1') return;

    const confirmation = {{ 'Release this hold? Confirm the provider issue is resolved. For an interrupted request, stop all sending processes first. This action sends nothing.'|t('sms-manager')|json_encode|raw }};
    if (!window.confirm(`${trigger.dataset.handle}\n${trigger.dataset.laneLabel}\n\n${confirmation}`)) return;

    trigger.dataset.releasing = '1';
    trigger.setAttribute('aria-disabled', 'true');
    if (trigger.tagName === 'BUTTON') trigger.disabled = true;
    try {
        const response = await Craft.sendActionRequest('POST', 'sms-manager/providers/release-transport-hold', {
            data: {handle: trigger.dataset.handle, lane: trigger.dataset.lane, token: trigger.dataset.token, confirmed: '1'},
        });
        if (response.data.success) {
            Craft.cp.displayNotice(response.data.message);
            window.location.reload();
        } else {
            Craft.cp.displayError(response.data.message);
        }
    } catch (error) {
        Craft.cp.displayError({{ 'The hold could not be released. Refresh the page and try again.'|t('sms-manager')|json_encode|raw }});
    } finally {
        delete trigger.dataset.releasing;
        trigger.removeAttribute('aria-disabled');
        if (trigger.tagName === 'BUTTON') trigger.disabled = false;
    }
});
{% endjs %}
