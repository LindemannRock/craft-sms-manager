#!/usr/bin/env bash
set -euo pipefail

php craft plugin/list

php craft exec '
use Craft;
use lindemannrock\logginglibrary\LoggingLibrary;
use lindemannrock\smsmanager\models\Settings;
use lindemannrock\smsmanager\providers\MppSmsProvider;
use lindemannrock\smsmanager\providers\TwilioProvider;
use lindemannrock\smsmanager\SmsManager;

$plugins = Craft::$app->getPlugins();
$plugin = $plugins->getPlugin("sms-manager");

if (!$plugin instanceof SmsManager) {
    throw new RuntimeException("SMS Manager plugin class was not loaded.");
}

foreach (["sms-manager", "logging-library"] as $handle) {
    if (!$plugins->isPluginInstalled($handle) || !$plugins->isPluginEnabled($handle)) {
        throw new RuntimeException("Required Craft plugin is not installed and enabled: {$handle}");
    }
}

if (!$plugins->getPlugin("logging-library") instanceof LoggingLibrary) {
    throw new RuntimeException("Logging Library dependency was not loaded.");
}

if (!Craft::$app->getModule("lindemannrock-base") instanceof \yii\base\Module) {
    throw new RuntimeException("Base module was not registered.");
}

$settings = $plugin->getSettings();
if (!$settings instanceof Settings) {
    throw new RuntimeException("SMS Manager settings model was not loaded.");
}

if (
    $settings->enableAnalytics !== true
    || $settings->analyticsLimit !== 1000
    || $settings->analyticsRetention !== 30
    || $settings->enableSmsLogs !== true
    || $settings->smsLogsLimit !== 10000
    || $settings->smsLogsRetention !== 30
) {
    throw new RuntimeException("SMS Manager fresh-install settings defaults are not intact.");
}

foreach (["sms", "providers", "senderIds", "integrations", "recurringCleanup"] as $component) {
    if (!$plugin->has($component)) {
        throw new RuntimeException("Missing SMS Manager service component: {$component}");
    }
    $plugin->get($component);
}

$providerTypes = $plugin->providers->getProviderTypes(false);
if (($providerTypes["mpp-sms"] ?? null) !== MppSmsProvider::class) {
    throw new RuntimeException("MPP-SMS provider registration is unavailable.");
}
if (($providerTypes["twilio"] ?? null) !== TwilioProvider::class) {
    throw new RuntimeException("Twilio provider registration is unavailable.");
}
if ($plugin->providers->supportsDevelopmentSenders("mpp-sms") !== true) {
    throw new RuntimeException("MPP-SMS development-sender capability is unavailable.");
}
if ($plugin->providers->supportsDevelopmentSenders("twilio") !== false) {
    throw new RuntimeException("Twilio development-sender fallback changed unexpectedly.");
}

$sectionKeys = array_column($plugin->getCpSections($settings), "key");
foreach (["dashboard", "providers", "sender-ids", "analytics", "settings"] as $sectionKey) {
    if (!in_array($sectionKey, $sectionKeys, true)) {
        throw new RuntimeException("Missing SMS Manager CP section: {$sectionKey}");
    }
}

echo "SMS Manager runtime capability smoke passed.\n";
'
